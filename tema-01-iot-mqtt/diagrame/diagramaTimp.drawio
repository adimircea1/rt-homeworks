        <mxCell id="1oaKCIt-FV-KMFq4SjPB-98" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;whiteSpace=wrap;" value="eveniment acceptat → eliberare" vertex="1">
          <mxGeometry height="22" width="260" x="130" y="590" as="geometry" />
        </mxCell>
        <mxCell id="1oaKCIt-FV-KMFq4SjPB-99" edge="1" parent="1" style="endArrow=cross;endFill=0;html=1;strokeColor=#c62828;strokeWidth=2;dashed=1;" value="">
